# EODHD-API-Key (https://eodhd.com). Leer lassen = Demo-Modus mit synthetischen Daten.
EODHD_API_KEY=
# Optional: "demo" erzwingt den Demo-Modus, auch wenn ein Key gesetzt ist
DATA_MODE=
# Geschätztes Tagesbudget an API-Calls (Plan-Limit, Standard 100000)
EODHD_DAILY_BUDGET=100000
# Gleichzeitige Anfragen an EODHD
EODHD_MAX_CONCURRENCY=8
# Jahre Kurshistorie pro Abruf
HISTORY_YEARS=10

# --- KI-Helfer (LM Studio) ---------------------------------------------------
# LM Studio: unter "Developer" den lokalen Server starten (Standard http://localhost:1234/v1).
# auto = LM Studio nutzen, wenn erreichbar (im Demo-Modus sonst regelbasierte Demo-KI)
# lmstudio = nur LM Studio · demo = immer Demo-KI · off = aus
LLM_MODE=auto
LLM_BASE_URL=http://localhost:1234/v1
# Leer = das erste in LM Studio verfügbare Modell
LLM_MODEL=
# Nur nötig, wenn der Server einen Schlüssel verlangt
LLM_API_KEY=
# Wartezeit je Antwort, gleichzeitige Anfragen, Werkzeugschritte je Frage
LLM_TIMEOUT_SECONDS=180
LLM_MAX_CONCURRENCY=1
LLM_MAX_STEPS=6
