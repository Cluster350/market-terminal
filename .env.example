# EODHD-API-Key (https://eodhd.com). Leer lassen = Demo-Modus mit synthetischen Daten.
EODHD_API_KEY=
# Optional: "demo" erzwingt den Demo-Modus, auch wenn ein Key gesetzt ist
DATA_MODE=
# Geschätztes Tagesbudget an API-Calls (Plan-Limit, Standard 100000)
EODHD_DAILY_BUDGET=100000
# Gleichzeitige Anfragen an EODHD
EODHD_MAX_CONCURRENCY=8
# Jahre Kurshistorie pro Abruf
HISTORY_YEARS=10

# --- KI-Helfer (LM Studio) ---------------------------------------------------
# LM Studio: unter "Developer" den lokalen Server starten (Standard http://localhost:1234/v1).
# auto = LM Studio nutzen, wenn erreichbar (im Demo-Modus sonst regelbasierte Demo-KI)
# lmstudio = nur LM Studio · demo = immer Demo-KI · off = aus
LLM_MODE=auto
LLM_BASE_URL=http://localhost:1234/v1
# Leer = das erste in LM Studio verfügbare Modell
LLM_MODEL=
# Nur nötig, wenn der Server einen Schlüssel verlangt
LLM_API_KEY=
# Wartezeit je Antwort, gleichzeitige Anfragen, Werkzeugschritte je Frage
LLM_TIMEOUT_SECONDS=180
LLM_MAX_CONCURRENCY=1
LLM_MAX_STEPS=6

# --- Depot (Seite 5 DEPOT) ---
# Ordner für die Depotdatei (depot-demo.json bzw. depot-eodhd.json). Standard: Benutzerordner\.market-terminal
# PORTFOLIO_DIR=

# --- Kursalarme (Funktion ALRT) ---
# Prüfabstand in Sekunden; leer = automatisch (Demo 15, EODHD 60). Jede Prüfung kostet je Wert einen API-Call.
# ALERT_INTERVAL_SECONDS=

# Echtzeit-Kurse über den EODHD-WebSocket (US- und europäische Aktien, Devisen, Krypto; Paket All-In-One).
# auto = einschalten, wenn ein Schlüssel da ist (Demo: simulierter Strom); off = nur verzögerte Kurse
# REALTIME=auto

# Prognose (ECST, ECO, Kegel im Kurschart, OMON): "auto" nutzt Chronos-2, wenn installiert
# (werkzeuge\Prognose installieren.bat), sonst die eingebaute Statistik; je Reihe gewinnt die
# Methode, die im Rückblick-Test genauer war. "simple" = nur Statistik, "off" = aus.
# FORECAST_MODE=auto
# FORECAST_DEVICE=cpu

# Fenster unter Windows: 1 (Standard) = eigenes App-Fenster ohne Adressleiste (wenn der Standardbrowser Edge oder Chrome ist),
# 0 = normaler Tab im Standardbrowser. Adresse in jedem Browser: http://127.0.0.1:8000
# MT_APP_FENSTER=1
