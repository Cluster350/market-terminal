# EODHD-API-Key (https://eodhd.com). Leer lassen = Demo-Modus mit synthetischen Daten.
EODHD_API_KEY=
# Optional: "demo" erzwingt den Demo-Modus, auch wenn ein Key gesetzt ist
DATA_MODE=
# Geschätztes Tagesbudget an API-Calls (Plan-Limit, Standard 100000)
EODHD_DAILY_BUDGET=100000
# Gleichzeitige Anfragen an EODHD
EODHD_MAX_CONCURRENCY=8
# Jahre Kurshistorie pro Abruf
HISTORY_YEARS=10
